{
  "name": "nexora-business-design-studio",
  "productName": "NEXORA Business Design Studio",
  "description": "A connected workspace for turning business ideas into structured businesses.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "NEXORA Studio <support@nexora.studio>",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "dev:desktop": "ELECTRON_START_URL=http://localhost:3000 NODE_ENV=development electron .",
    "build:desktop": "npm run build && electron-builder --win --x64 --dir",
    "dist": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir",
    "electron": "electron .",
    "generate:icons": "node scripts/generate-icons.js"
  },
  "build": {
    "appId": "com.nexora.desktop",
    "productName": "NEXORA",
    "copyright": "Copyright © 2026 NEXORA Studio. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "executableName": "NEXORA"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "NEXORA",
      "uninstallDisplayName": "NEXORA",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false,
      "artifactName": "NEXORA-Setup.exe"
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
